{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aos-data.org/schema/regiment.schema.json",
  "title": "Regiment",
  "description": "A regiment in an army list with leader and unit selections",
  "type": "object",
  "properties": {
    "leader": {
      "type": "object",
      "properties": {
        "unitId": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "reinforced": {
          "type": "boolean"
        }
      },
      "required": [
        "unitId",
        "count"
      ],
      "additionalProperties": false
    },
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "unitId": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "count": {
            "type": "integer",
            "minimum": 1
          },
          "reinforced": {
            "type": "boolean"
          }
        },
        "required": [
          "unitId",
          "count"
        ],
        "additionalProperties": false
      },
      "maxItems": 4
    },
    "regimentOfRenownId": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    }
  },
  "required": [
    "leader"
  ],
  "additionalProperties": false
}
