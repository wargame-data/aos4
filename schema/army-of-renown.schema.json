{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aos-data.org/schema/army-of-renown.schema.json",
  "title": "Army of Renown",
  "description": "An Army of Renown index for Age of Sigmar 4th Edition",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "name": {
      "type": "string"
    },
    "parentFaction": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "grandAlliance": {
      "type": "string",
      "enum": [
        "order",
        "chaos",
        "death",
        "destruction"
      ]
    },
    "armyKeywords": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "units": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      }
    },
    "heroes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      }
    },
    "terrain": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      }
    },
    "lores": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "name": {
            "type": "string"
          },
          "file": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "file"
        ],
        "additionalProperties": false
      }
    },
    "enhancements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "name": {
            "type": "string"
          },
          "file": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "file"
        ],
        "additionalProperties": false
      }
    },
    "regimentsOfRenown": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "name": {
            "type": "string"
          },
          "file": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "file"
        ],
        "additionalProperties": false
      }
    },
    "battleTraits": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "name": {
          "type": "string"
        },
        "file": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "file"
      ],
      "additionalProperties": false
    },
    "_meta": {
      "type": "object",
      "properties": {
        "lastUpdated": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "name",
    "parentFaction",
    "grandAlliance"
  ],
  "additionalProperties": false
}
