{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aos-data.org/schema/hero.schema.json",
  "title": "Hero",
  "description": "A hero warscroll for Age of Sigmar 4th Edition",
  "type": "object",
  "required": [
    "id",
    "name",
    "faction",
    "points",
    "stats",
    "role",
    "keywords",
    "baseSize",
    "weapons"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Reference to this schema"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Unique identifier (kebab-case)"
    },
    "name": {
      "type": "string",
      "description": "Display name of the hero"
    },
    "faction": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Faction identifier (kebab-case)"
    },
    "grandAlliance": {
      "type": "string",
      "enum": ["order", "chaos", "death", "destruction"],
      "description": "Grand Alliance this hero belongs to"
    },
    "points": {
      "type": "integer",
      "minimum": 0,
      "description": "Points cost for the hero"
    },
    "stats": {
      "type": "object",
      "required": ["move", "health", "save", "control"],
      "properties": {
        "move": {
          "type": "string",
          "pattern": "^(\\d+|D6|D6\\+\\d+)\"$",
          "description": "Movement characteristic (e.g., '5\"' or 'D6+8\"')"
        },
        "health": {
          "type": "integer",
          "minimum": 1,
          "description": "Health/wounds characteristic"
        },
        "save": {
          "type": "string",
          "pattern": "^\\d\\+$",
          "description": "Save characteristic (e.g., '4+')"
        },
        "control": {
          "type": "integer",
          "minimum": 0,
          "description": "Control characteristic"
        }
      },
      "additionalProperties": false
    },
    "role": {
      "type": "string",
      "enum": ["battleline", "other", "artillery", "behemoth"],
      "description": "Battlefield role"
    },
    "keywords": {
      "type": "array",
      "items": { "type": "string" },
      "description": "All keywords for the hero"
    },
    "regimentKeywords": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Keywords used for regiment building"
    },
    "baseSize": {
      "type": "integer",
      "minimum": 1,
      "description": "Model count (usually 1 for heroes)"
    },
    "maxSize": {
      "type": "integer",
      "minimum": 1,
      "description": "Maximum model count"
    },
    "canReinforce": {
      "type": "boolean",
      "description": "Whether the unit can be reinforced"
    },
    "isCollective": {
      "type": "boolean",
      "description": "Whether the unit is a collective/swarm unit (tracks casualties collectively)"
    },
    "costs": {
      "type": "object",
      "description": "Alternative cost types for different game formats",
      "properties": {
        "destinyPoints": {
          "type": "integer",
          "minimum": 0,
          "description": "Destiny Points cost"
        },
        "ptgCategory": {
          "type": "integer",
          "minimum": 0,
          "description": "Path to Glory category value"
        },
        "ghbCategory": {
          "type": "integer",
          "minimum": 0,
          "description": "General's Handbook category value"
        }
      },
      "additionalProperties": false
    },
    "rules": {
      "type": "array",
      "description": "Non-ability rules attached to the hero (e.g., base size, restrictions)",
      "items": {
        "type": "object",
        "required": ["name", "description"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Rule name"
          },
          "description": {
            "type": "string",
            "description": "Rule description/text"
          }
        },
        "additionalProperties": false
      }
    },
    "publication": {
      "type": "object",
      "description": "Source publication reference",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Publication name"
        },
        "shortName": {
          "type": "string",
          "description": "Short/abbreviated publication name"
        },
        "page": {
          "type": "string",
          "description": "Page number reference"
        }
      },
      "additionalProperties": false
    },
    "weapons": {
      "type": "array",
      "items": { "$ref": "weapon.schema.json" },
      "description": "Weapon profiles for the hero"
    },
    "abilities": {
      "type": "array",
      "items": { "$ref": "ability.schema.json" },
      "description": "Hero abilities"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes or clarifications"
    },
    "isWizard": {
      "oneOf": [
        { "type": "integer", "minimum": 1 },
        { "type": "null" }
      ],
      "description": "Wizard level (number of spells that can be cast/unbound per phase)"
    },
    "isPriest": {
      "oneOf": [
        { "type": "integer", "minimum": 1 },
        { "type": "null" }
      ],
      "description": "Priest level (number of prayers that can be chanted per phase)"
    },
    "isUnique": {
      "type": "boolean",
      "description": "Whether this is a unique/named character"
    },
    "regimentAllows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["keywords", "description"],
        "properties": {
          "keywords": {
            "type": "array",
            "items": { "type": "string" }
          },
          "description": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "description": "What units this hero can lead in a regiment"
    },
    "canJoinRegiment": {
      "oneOf": [
        {
          "type": "object",
          "required": ["keywords"],
          "properties": {
            "keywords": {
              "type": "array",
              "items": { "type": "string" }
            },
            "description": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        { "type": "null" }
      ],
      "description": "If this hero can join another hero's regiment (e.g., totems)"
    },
    "_meta": {
      "type": "object",
      "properties": {
        "lastUpdated": {
          "type": "string",
          "format": "date",
          "description": "Date of last update (YYYY-MM-DD)"
        },
        "source": {
          "type": "string",
          "description": "Official source document"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
