{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aos-data.org/schema/ability.schema.json",
  "title": "Ability",
  "description": "An ability for an Age of Sigmar unit or hero",
  "type": "object",
  "required": ["name", "type", "effect"],
  "properties": {
    "name": {
      "type": "string",
      "description": "The ability's name"
    },
    "type": {
      "type": "string",
      "enum": [
        "passive",
        "reaction",
        "once-per-turn",
        "once-per-battle",
        "spell",
        "prayer",
        "command"
      ],
      "description": "The type/timing of the ability"
    },
    "phase": {
      "type": "string",
      "enum": [
        "any",
        "hero",
        "movement",
        "shooting",
        "charge",
        "combat",
        "end"
      ],
      "description": "The phase when this ability can be used"
    },
    "castingValue": {
      "type": "integer",
      "minimum": 2,
      "maximum": 12,
      "description": "Casting value for spells"
    },
    "chantingValue": {
      "type": "integer",
      "minimum": 2,
      "maximum": 6,
      "description": "Chanting value for prayers"
    },
    "declare": {
      "type": "string",
      "description": "Declaration requirements for the ability"
    },
    "effect": {
      "type": "string",
      "description": "The effect of the ability"
    },
    "keywords": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Keywords associated with this ability (e.g., 'SPELL', 'PRAYER', 'UNLIMITED')"
    },
    "color": {
      "type": "string",
      "enum": ["Black", "Blue", "Gray", "Green", "Orange", "Purple", "Red", "Yellow"],
      "description": "Visual categorization color from BSData"
    },
    "abilityCategory": {
      "type": "string",
      "enum": ["Offensive", "Defensive", "Movement", "Control", "Special", "Rallying", "Shooting"],
      "description": "Functional categorization of the ability"
    },
    "modifiers": {
      "type": "array",
      "items": { "$ref": "#/definitions/modifier" },
      "description": "Conditional modifiers that affect this ability"
    }
  },
  "definitions": {
    "modifier": {
      "type": "object",
      "required": ["type", "field", "value"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["set", "increment", "decrement", "append", "add", "remove"],
          "description": "The type of modification"
        },
        "field": {
          "type": "string",
          "description": "The field being modified"
        },
        "value": {
          "type": "string",
          "description": "The value to apply"
        },
        "conditions": {
          "$ref": "#/definitions/conditionGroup"
        }
      }
    },
    "conditionGroup": {
      "type": "object",
      "required": ["logic"],
      "properties": {
        "logic": {
          "type": "string",
          "enum": ["and", "or"],
          "description": "How conditions are combined"
        },
        "conditions": {
          "type": "array",
          "items": { "$ref": "#/definitions/condition" }
        },
        "groups": {
          "type": "array",
          "items": { "$ref": "#/definitions/conditionGroup" }
        }
      }
    },
    "condition": {
      "type": "object",
      "required": ["type", "value", "field"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["equalTo", "notEqualTo", "lessThan", "greaterThan", "atLeast", "atMost", "instanceOf"],
          "description": "The condition type"
        },
        "value": {
          "type": "string",
          "description": "The value to compare against"
        },
        "field": {
          "type": "string",
          "description": "The field to check"
        },
        "scope": {
          "type": "string",
          "description": "The scope of the condition"
        },
        "childId": {
          "type": "string",
          "description": "Reference to a child entry"
        }
      }
    }
  }
}
