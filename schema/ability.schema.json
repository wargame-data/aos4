{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://wargamedata.com/aos4/schema/ability.schema.json",
  "title": "Ability",
  "description": "An ability for an Age of Sigmar unit or hero",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "passive",
        "reaction",
        "once-per-turn",
        "once-per-battle",
        "spell",
        "prayer",
        "command"
      ]
    },
    "phase": {
      "type": "string",
      "enum": [
        "any",
        "hero",
        "movement",
        "shooting",
        "charge",
        "combat",
        "end"
      ]
    },
    "castingValue": {
      "type": "integer",
      "minimum": 2,
      "maximum": 12
    },
    "chantingValue": {
      "type": "integer",
      "minimum": 2,
      "maximum": 6
    },
    "declare": {
      "type": "string"
    },
    "effect": {
      "type": "string"
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "color": {
      "type": "string",
      "enum": [
        "Black",
        "Blue",
        "Gray",
        "Green",
        "Orange",
        "Purple",
        "Red",
        "Yellow"
      ]
    },
    "abilityCategory": {
      "type": "string",
      "enum": [
        "Offensive",
        "Defensive",
        "Movement",
        "Control",
        "Special",
        "Rallying",
        "Shooting"
      ]
    },
    "modifiers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "set",
              "increment",
              "decrement",
              "append",
              "add",
              "remove"
            ]
          },
          "field": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "conditions": {
            "type": "object",
            "properties": {
              "logic": {
                "type": "string",
                "enum": [
                  "and",
                  "or"
                ]
              },
              "conditions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "equalTo",
                        "notEqualTo",
                        "lessThan",
                        "greaterThan",
                        "atLeast",
                        "atMost",
                        "instanceOf"
                      ]
                    },
                    "value": {
                      "type": "string"
                    },
                    "field": {
                      "type": "string"
                    },
                    "scope": {
                      "type": "string"
                    },
                    "childId": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "type",
                    "value",
                    "field"
                  ],
                  "additionalProperties": false
                }
              },
              "groups": {
                "type": "array",
                "items": {}
              }
            },
            "required": [
              "logic"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "type",
          "field",
          "value"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "name",
    "type",
    "effect"
  ],
  "additionalProperties": false
}
