{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aos-data.org/schema/blood-tithe-ability.schema.json",
  "title": "Blood Tithe Ability",
  "description": "A Blood Tithe ability for Blades of Khorne faction",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "name": {
      "type": "string"
    },
    "faction": {
      "type": "string",
      "const": "blades-of-khorne"
    },
    "bloodTithePoints": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8
    },
    "unlockCondition": {
      "type": "string"
    },
    "parentAbilityId": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "usedBy": {
      "type": "string"
    },
    "timing": {
      "type": "string"
    },
    "declare": {
      "type": "string"
    },
    "effect": {
      "type": "string"
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "color": {
      "type": "string",
      "enum": [
        "Black",
        "Blue",
        "Gray",
        "Green",
        "Orange",
        "Purple",
        "Red",
        "Yellow"
      ]
    },
    "abilityCategory": {
      "type": "string",
      "enum": [
        "Offensive",
        "Defensive",
        "Movement",
        "Control",
        "Special",
        "Rallying",
        "Shooting"
      ]
    },
    "_meta": {
      "type": "object",
      "properties": {
        "lastUpdated": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "name",
    "faction",
    "bloodTithePoints",
    "effect"
  ],
  "additionalProperties": false
}
