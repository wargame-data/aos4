{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aos-data.org/schema/manifestation.schema.json",
  "title": "Manifestation",
  "description": "A manifestation (endless spell) warscroll for Age of Sigmar 4th Edition",
  "type": "object",
  "required": [
    "id",
    "name",
    "faction",
    "points",
    "stats",
    "keywords"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Reference to this schema"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Unique identifier (kebab-case)"
    },
    "name": {
      "type": "string",
      "description": "Display name of the manifestation"
    },
    "faction": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Faction identifier (kebab-case)"
    },
    "grandAlliance": {
      "type": "string",
      "enum": ["order", "chaos", "death", "destruction"],
      "description": "Grand Alliance this manifestation belongs to"
    },
    "points": {
      "type": "integer",
      "minimum": 0,
      "description": "Points cost for the manifestation"
    },
    "stats": {
      "type": "object",
      "required": ["move", "health", "save", "banishment"],
      "properties": {
        "move": {
          "type": "string",
          "pattern": "^(\\d+|D6|D6\\+\\d+)\"$",
          "description": "Movement characteristic (e.g., '8\"')"
        },
        "health": {
          "type": "integer",
          "minimum": 1,
          "description": "Health/wounds characteristic"
        },
        "save": {
          "type": "string",
          "description": "Save characteristic (e.g., '6+' or '-')"
        },
        "banishment": {
          "type": "integer",
          "minimum": 1,
          "description": "Banishment characteristic"
        }
      },
      "additionalProperties": false
    },
    "keywords": {
      "type": "array",
      "items": { "type": "string" },
      "description": "All keywords for the manifestation"
    },
    "baseSize": {
      "type": "string",
      "description": "Base size description"
    },
    "costs": {
      "type": "object",
      "description": "Alternative cost types for different game formats",
      "properties": {
        "destinyPoints": {
          "type": "integer",
          "minimum": 0,
          "description": "Destiny Points cost"
        },
        "ptgCategory": {
          "type": "integer",
          "minimum": 0,
          "description": "Path to Glory category value"
        },
        "ghbCategory": {
          "type": "integer",
          "minimum": 0,
          "description": "General's Handbook category value"
        }
      },
      "additionalProperties": false
    },
    "publication": {
      "type": "object",
      "description": "Source publication reference",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Publication name"
        },
        "shortName": {
          "type": "string",
          "description": "Short/abbreviated publication name"
        },
        "page": {
          "type": "string",
          "description": "Page number reference"
        }
      },
      "additionalProperties": false
    },
    "weapons": {
      "type": "array",
      "items": { "$ref": "weapon.schema.json" },
      "description": "Weapon profiles for the manifestation"
    },
    "abilities": {
      "type": "array",
      "items": { "$ref": "ability.schema.json" },
      "description": "Manifestation abilities"
    },
    "_meta": {
      "type": "object",
      "properties": {
        "lastUpdated": {
          "type": "string",
          "format": "date",
          "description": "Date of last update (YYYY-MM-DD)"
        },
        "source": {
          "type": "string",
          "description": "Official source document"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
