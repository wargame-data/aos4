{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aos-data.org/schema/enhancement.schema.json",
  "title": "Enhancement Collection",
  "description": "A collection of enhancements (heroic traits or artefacts) for Age of Sigmar",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "name": {
      "type": "string"
    },
    "faction": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "type": {
      "type": "string",
      "enum": [
        "heroic-trait",
        "artefact"
      ]
    },
    "enhancements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "restrictions": {
            "type": "string"
          },
          "ability": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": [
                  "passive",
                  "reaction",
                  "once-per-turn",
                  "once-per-battle",
                  "spell",
                  "prayer",
                  "command"
                ]
              },
              "phase": {
                "type": "string",
                "enum": [
                  "any",
                  "hero",
                  "movement",
                  "shooting",
                  "charge",
                  "combat",
                  "end"
                ]
              },
              "castingValue": {
                "type": "integer",
                "minimum": 2,
                "maximum": 12
              },
              "chantingValue": {
                "type": "integer",
                "minimum": 2,
                "maximum": 6
              },
              "declare": {
                "type": "string"
              },
              "effect": {
                "type": "string"
              },
              "keywords": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "color": {
                "type": "string",
                "enum": [
                  "Black",
                  "Blue",
                  "Gray",
                  "Green",
                  "Orange",
                  "Purple",
                  "Red",
                  "Yellow"
                ]
              },
              "abilityCategory": {
                "type": "string",
                "enum": [
                  "Offensive",
                  "Defensive",
                  "Movement",
                  "Control",
                  "Special",
                  "Rallying",
                  "Shooting"
                ]
              },
              "modifiers": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "set",
                        "increment",
                        "decrement",
                        "append",
                        "add",
                        "remove"
                      ]
                    },
                    "field": {
                      "type": "string"
                    },
                    "value": {
                      "type": "string"
                    },
                    "conditions": {
                      "type": "object",
                      "properties": {
                        "logic": {
                          "type": "string",
                          "enum": [
                            "and",
                            "or"
                          ]
                        },
                        "conditions": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "type": {
                                "type": "string",
                                "enum": [
                                  "equalTo",
                                  "notEqualTo",
                                  "lessThan",
                                  "greaterThan",
                                  "atLeast",
                                  "atMost",
                                  "instanceOf"
                                ]
                              },
                              "value": {
                                "type": "string"
                              },
                              "field": {
                                "type": "string"
                              },
                              "scope": {
                                "type": "string"
                              },
                              "childId": {
                                "type": "string"
                              }
                            },
                            "required": [
                              "type",
                              "value",
                              "field"
                            ],
                            "additionalProperties": false
                          }
                        },
                        "groups": {
                          "type": "array",
                          "items": {}
                        }
                      },
                      "required": [
                        "logic"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "type",
                    "field",
                    "value"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "name",
              "type",
              "effect"
            ],
            "additionalProperties": false
          },
          "points": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      }
    },
    "_meta": {
      "type": "object",
      "properties": {
        "lastUpdated": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "name",
    "faction",
    "type",
    "enhancements"
  ],
  "additionalProperties": false
}
