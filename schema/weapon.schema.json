{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aos-data.org/schema/weapon.schema.json",
  "title": "Weapon",
  "description": "A weapon profile for an Age of Sigmar unit",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "melee",
        "ranged"
      ]
    },
    "range": {
      "type": "string",
      "pattern": "^\\d+\"$"
    },
    "attacks": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "string",
          "pattern": "^\\d?[dD]\\d+.*$"
        }
      ]
    },
    "hit": {
      "type": "string",
      "pattern": "^\\d\\+$"
    },
    "wound": {
      "type": "string",
      "pattern": "^\\d\\+$"
    },
    "rend": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    },
    "damage": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "string",
          "pattern": "^\\d?[dD]\\d+.*$"
        },
        {
          "type": "string",
          "pattern": "^⟝.*⟞$"
        }
      ]
    },
    "abilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "name",
    "type",
    "attacks",
    "hit",
    "wound",
    "rend",
    "damage"
  ],
  "additionalProperties": false
}
