{
  "name": "@aos-data/core",
  "version": "0.1.0",
  "description": "Community-maintained Age of Sigmar 4th Edition game data in JSON format",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "data",
    "schema"
  ],
  "scripts": {
    "build": "tsc",
    "validate": "node dist/tools/validator/index.js",
    "validate:watch": "tsc && node dist/tools/validator/index.js",
    "test": "npm run build && npm run validate",
    "prepublishOnly": "npm run test"
  },
  "keywords": [
    "age-of-sigmar",
    "aos",
    "warhammer",
    "game-data",
    "json"
  ],
  "author": "aos-data community",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aos-data/aos-data.git"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "glob": "^13.0.0",
    "typescript": "^5.9.3"
  }
}
