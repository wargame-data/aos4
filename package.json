{
  "name": "@wargame-data/aos4",
  "version": "0.1.0",
  "description": "Community-maintained Age of Sigmar 4th Edition game data in JSON format",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts"
    },
    "./data/*": "./data/*"
  },
  "files": [
    "dist",
    "data",
    "schema"
  ],
  "scripts": {
    "build": "tsc",
    "catalog:sync": "npm run build && node dist/tools/parser/catalog-parser.js",
    "schema:generate": "node dist/tools/schemas/generate.js",
    "schema:build": "npm run build && npm run schema:generate",
    "test": "npm run build && npm run schema:generate",
    "test:unit": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "age-of-sigmar",
    "aos",
    "warhammer",
    "game-data",
    "json"
  ],
  "author": "wargame-data community",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wargame-data/aos4.git"
  },
  "dependencies": {
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "@types/xml2js": "^0.4.14",
    "glob": "^13.0.0",
    "simple-git": "^3.30.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16",
    "xml2js": "^0.6.2",
    "zod-to-json-schema": "^3.24.1"
  }
}
